# Copy to .env.local (never commit real keys).

# Qloo hackathon key. Leave empty to run in simulation mode.
QLOO_API_KEY=
# QLOO_API_URL=https://hackathon.api.qloo.com
# QLOO_MODE=mock

# Google AI Studio key for the LLM agent (free tier). Leave empty for the scripted agent.
GOOGLE_GENERATIVE_AI_API_KEY=
# ENCORE_LLM_MODEL=gemini-flash-latest
# ENCORE_LLM=off

# Simulated latency per Qloo call in simulation mode (ms), so the demo animation is visible.
# ENCORE_MOCK_LATENCY_MS=220
